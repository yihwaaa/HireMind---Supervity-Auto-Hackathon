# ===================================================================
#      AUTOPILOT COMMAND CENTER - ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------------
#  Copy this file to .env to get started.
#  Defaults work out of the box — just run: make up
# ===================================================================

# ------------------------------------------------------------
# BACKEND
# ------------------------------------------------------------
APP_ENV=development
FRONTEND_URL=http://localhost:3001
LOG_LEVEL=INFO

# Supervity Auto — Orchestrator / Operators integration
# Generate at https://auto.supervity.ai/u/api-keys (pick the workspace
# your Orchestrator lives in). Never put this in the frontend/browser.
SUPERVITY_API_KEY=
# Optional but recommended — your org key from the workspace switcher URL.
SUPERVITY_ORG_KEY=
SUPERVITY_BASE_URL=https://auto.supervity.ai
# Your Orchestrator's workflow ID — copy from the Auto UI's URL when you
# have it open, or from GET /api/supervity/workflows/{id} once you have it.
SUPERVITY_ORCHESTRATOR_WORKFLOW_ID=

# Supabase — your Operators' system of record (separate from the Postgres
# above, which is only the Command Center's own DB). Used for a live health
# check in the Data Manager. Project URL and anon/service key from
# Supabase → Settings → API.
SUPABASE_URL=
SUPABASE_KEY=

# Auth bypass — all requests auto-authenticated as Dev User (admin role)
AUTH_BYPASS=true

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=app_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------
# FRONTEND
# ------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_BASE_PATH=

# NextAuth (required for session management even with AUTH_BYPASS)
NEXTAUTH_URL=http://localhost:3001

# REQUIRED: A secret used to sign and encrypt NextAuth.js tokens.
# Generate with:
#   macOS/Linux: openssl rand -base64 32
#   Windows:     [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
NEXTAUTH_SECRET=

# ------------------------------------------------------------
# DOCKER
# ------------------------------------------------------------
# "dev" = hot reload | "prod" = optimized build
FRONTEND_TARGET=dev
